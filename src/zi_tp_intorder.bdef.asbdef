managed implementation in class zbp_i_tp_intorder unique;
strict ( 2 );

define behavior for ZI_TP_IntOrder alias PurchaseOrder
persistent table ztp_int_order
lock master
authorization master ( none )
//etag master <field_name>
{
  create ( authorization : global );
  action dispatch result [1] $self;
  static action resetDemo;
  action changeMaterial parameter ZD_TP_CHANGE_MATERIAL result [1] $self;
  update;
  delete;
  field ( mandatory : create, readonly : update ) OrderId;

  mapping for ztp_int_order
  {
    OrderId = order_id;
    Supplier = supplier;
    Material = material;
    Quantity = quantity;
    DeliveryDate = delivery_date;
    IntegrationStatus = integration_status;
    SupplierOrderId = supplier_order_id;
    ConfirmedDeliveryDate = confirmed_delivery_date;
  }

}